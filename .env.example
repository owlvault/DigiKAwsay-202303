# ============================================================
# DigiKawsay — Variables de entorno para desarrollo local
# Copiar como .env y completar con valores reales.
# NUNCA commitear el archivo .env con valores reales.
# ============================================================

# --- Credenciales obligatorias ---
GEMINI_API_KEY=your-gemini-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# --- Base de datos (valores por defecto para docker-compose local) ---
DATABASE_URL=postgresql://digikawsay_app:local_password_123@localhost:5432/digikawsay

# --- Google Cloud Pub/Sub (emulador local por defecto) ---
GCP_PROJECT_ID=my-local-project
PUBSUB_EMULATOR_HOST=localhost:8085

# --- Weaviate (instancia local por defecto) ---
WEAVIATE_URL=http://localhost:8081

# --- Vertex AI Embeddings ---
# Poner "true" para desarrollo local (usa vector cero en lugar de llamar a Vertex AI)
VERTEX_AI_DISABLED=true
# Ruta al JSON de credenciales de GCP (requerido en producción si VERTEX_AI_DISABLED=false)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
VERTEX_LOCATION=us-central1
